# ===================================================
# Database Configuration (Aiven MySQL / MySQL Server)
# ===================================================
# Salin file ini menjadi .env.local untuk menjalankan secara lokal
# cp .env.example .env.local

# Host database Aiven (contoh: mysql-xxx-xxx.aivencloud.com)
DB_HOST=

# Port database Aiven (default MySQL Aiven biasanya berupa port dinamis, contoh: 24789 atau 3306)
DB_PORT=

# Username database Aiven (contoh: avnadmin)
DB_USER=

# Password database Aiven
DB_PASSWORD=

# Nama database yang sudah ada di Aiven
DB_NAME=money_tracker

# Konfigurasi SSL/TLS untuk koneksi Aiven MySQL
# Set 'true' untuk mengaktifkan koneksi SSL yang aman
DB_SSL=true

# Set 'false' jika ingin mengabaikan verifikasi CA cert self-signed Aiven
DB_SSL_REJECT_UNAUTHORIZED=false

# Opsional: Jika menggunakan CA certificate string (Base64 atau PEM format)
DB_CA_CERT=
